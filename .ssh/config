Host dortmund gwkilab
    HostName gwkilab.cs.tu-dortmund.de
    User huebers
    IdentityFile ~/.ssh/id_ed25519

Host ml2ran02
    HostName ml2ran02.lamarr.tu-dortmund.de
    User huebers
    ProxyJump dortmund

Host mission-control mc
    HostName ml2ran02s0
    ProxyJump gwkilab
    Port 25000
    User huebers
    IdentityFile ~/.ssh/id_ed25519

# LTS2 lab frontend
Host lts2
    HostName stivm0163.xaas.epfl.ch
    User huebers
    IdentityFile ~/.ssh/id_ed25519

# LTS2 through the user-owned Oracle reverse tunnel.
# Requires an `oracle` SSH alias and the tunnel to be running.
Host lts2-via-oracle
    HostName stivm0163.xaas.epfl.ch
    User huebers
    IdentityFile ~/.ssh/id_ed25519
    ProxyCommand ssh oracle -W 127.0.0.1:2222

# Separate RCP cluster; this is not the LTS2 frontend.
Host rcp
    HostName jumphost.rcp.epfl.ch
    User huebers
    IdentityFile ~/.ssh/id_ed25519

