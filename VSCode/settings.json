{
    "debug.console.fontSize": 14,
    "workbench.startupEditor": "none",
    "git.autofetch": true,
    "editor.cursorBlinking": "solid",
    "chat.useNestedAgentsMdFiles": true,
    "workbench.colorCustomizations": {
        "list.focusOutline": "#00000000",
        "list.inactiveFocusOutline": "#00000000",
        "focusBorder": "#00000000",
        "list.focusAndSelectionOutline": "#00000000",
    },
    "workbench.tree.indent": 12,
    "[python]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[latex]": {
        "editor.wordWrap": "on",
        "editor.defaultFormatter": "James-Yu.latex-workshop",
        "editor.formatOnSave": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[tex]": {
        "editor.wordWrap": "on",
        "editor.defaultFormatter": "James-Yu.latex-workshop",
        "editor.formatOnSave": false,
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.auxDir": "%OUTDIR%",
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.path": "latexindent",
    "latex-workshop.formatting.latexindent.args": [
        "-m",
        "-rv",
        "-l=%DIR%/latexindent.yaml",
        "-c",
        "%DIR%/build/",
        "%TMPFILE%"
    ],
    "chat.viewSessions.orientation": "stacked",
    "workbench.activityBar.location": "bottom",
    "files.insertFinalNewline": true,
    "files.exclude": {
        "**/.git": true,
        "**/.pytest_cache": true,
        "**/.cursor": true,
        "**/.idea": true,
        "**/.ruff_cache": true,
        "**/.DS_Store": true,
        "**/*.egg-info": true,
        "**/__pycache__": true,
        "**/.github": true,
    },
    "python.analysis.typeCheckingMode": "standard",
    "workbench.colorTheme": "Light Modern",
    "workbench.editor.enablePreview": false,
    "code-runner.runInTerminal": true,
    "python-envs.terminal.autoActivationType": "shellStartup",
    "editor.hover.hidingDelay": 100,
    "workbench.hover.delay": 300,
    "workbench.hover.reducedDelay": 100,
    "workbench.sash.hoverDelay": 100,
    "workbench.reduceMotion": "on",
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "visible",
    "editor.minimap.enabled": false,
    "claudeCode.preferredLocation": "panel",
    "window.autoDetectColorScheme": true,
    "workbench.experimental.modernUI": false,
    "chat.remoteAgentHosts": [],
    "remote.tunnels.alwaysUpdateCLI": true,
    "workbench.editorAssociations": {
        "*.pdf": "latex-workshop-pdf-hook"
    }
}
